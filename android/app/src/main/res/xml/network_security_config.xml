<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP local (PC/VPS sem HTTPS) — em produção prefira HTTPS na VPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
